{{#if success_msg}}
<div class="jms-toast-alert mb-4 p-4 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 flex items-start justify-between shadow-sm">
  <div class="flex items-center space-x-3">
    <svg class="w-5 h-5 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
    </svg>
    <div class="text-sm font-medium">{{ success_msg }}</div>
  </div>
  <button onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-800">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
  </button>
</div>
{{/if}}

{{#if error_msg}}
<div class="jms-toast-alert mb-4 p-4 rounded-lg bg-rose-50 border border-rose-200 text-rose-800 flex items-start justify-between shadow-sm">
  <div class="flex items-center space-x-3">
    <svg class="w-5 h-5 text-rose-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
    </svg>
    <div class="text-sm font-medium">{{ error_msg }}</div>
  </div>
  <button onclick="this.parentElement.remove()" class="text-rose-500 hover:text-rose-800">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
  </button>
</div>
{{/if}}

{{#if info_msg}}
<div class="jms-toast-alert mb-4 p-4 rounded-lg bg-blue-50 border border-blue-200 text-blue-800 flex items-start justify-between shadow-sm">
  <div class="flex items-center space-x-3">
    <svg class="w-5 h-5 text-blue-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
    </svg>
    <div class="text-sm font-medium">{{ info_msg }}</div>
  </div>
  <button onclick="this.parentElement.remove()" class="text-blue-500 hover:text-blue-800">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
  </button>
</div>
{{/if}}

