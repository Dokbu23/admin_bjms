<aside id="main-sidebar" class="fixed inset-y-0 left-0 z-40 w-64 bg-slate-900 border-r border-slate-800 flex flex-col transition-transform duration-300 ease-in-out md:static md:translate-x-0 -translate-x-full">
  <!-- Brand / Header -->
  <div class="h-16 px-4 flex items-center justify-between border-b border-slate-800 bg-slate-950">
    <div class="flex items-center space-x-3">
      <div class="w-9 h-9 rounded-md bg-gradient-to-br from-amber-500 to-amber-700 flex items-center justify-center shadow-lg border border-amber-400">
        <svg class="w-5 h-5 text-slate-950 font-bold" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2L2 7v6c0 5.55 3.84 10.74 10 12 6.16-1.26 10-6.45 10-12V7l-10-5zm0 2.18l8 4V13c0 4.52-3.08 8.75-8 9.87-4.92-1.12-8-5.35-8-9.87V8.18l8-4zM11 7v2h2V7h-2zm0 4v6h2v-6h-2z"/>
        </svg>
      </div>
      <div>
        <span class="text-sm font-black text-white tracking-widest block uppercase">JMS ADMIN</span>
        <span class="text-[10px] font-semibold text-amber-400 block tracking-wider uppercase">Jail Management</span>
      </div>
    </div>
    <!-- Mobile Close -->
    <button onclick="document.getElementById('main-sidebar').classList.add('-translate-x-full')" class="md:hidden text-slate-400 hover:text-white">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
  </div>

  <!-- Role Indicator -->
  <div class="px-4 py-2.5 bg-slate-950/60 border-b border-slate-800/80 flex items-center justify-between text-xs">
    <span class="text-slate-400 font-medium">Active System Role:</span>
    <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/30">
      SYSTEM ADMIN
    </span>
  </div>

  <!-- Navigation Menu -->
  <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto sidebar-scroll text-sm">
    <!-- 1. Dashboard -->
    <a href="/dashboard" class="flex items-center px-3 py-2.5 rounded-md font-medium transition {{#if (eq currentPath '/dashboard')}}bg-amber-500/15 text-amber-400 border-l-4 border-amber-500 font-semibold{{else}}text-slate-300 hover:bg-slate-800 hover:text-white{{/if}}">
      <svg class="w-5 h-5 mr-3 flex-shrink-0 {{#if (eq currentPath '/dashboard')}}text-amber-400{{else}}text-slate-400{{/if}}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
      </svg>
      <span>1. Dashboard</span>
    </a>

    <!-- 2. User / Personnel Management -->
    <a href="/personnel" class="flex items-center px-3 py-2.5 rounded-md font-medium transition {{#if (contains currentPath '/personnel')}}bg-amber-500/15 text-amber-400 border-l-4 border-amber-500 font-semibold{{else}}text-slate-300 hover:bg-slate-800 hover:text-white{{/if}}">
      <svg class="w-5 h-5 mr-3 flex-shrink-0 {{#if (contains currentPath '/personnel')}}text-amber-400{{else}}text-slate-400{{/if}}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
      </svg>
      <span>2. User Management</span>
    </a>

    <!-- 3. PDL Records -->
    <a href="/pdl" class="flex items-center px-3 py-2.5 rounded-md font-medium transition {{#if (contains currentPath '/pdl')}}bg-amber-500/15 text-amber-400 border-l-4 border-amber-500 font-semibold{{else}}text-slate-300 hover:bg-slate-800 hover:text-white{{/if}}">
      <svg class="w-5 h-5 mr-3 flex-shrink-0 {{#if (contains currentPath '/pdl')}}text-amber-400{{else}}text-slate-400{{/if}}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
      </svg>
      <span>3. PDL Records</span>
    </a>

    <!-- 4. Reports -->
    <a href="/reports" class="flex items-center px-3 py-2.5 rounded-md font-medium transition {{#if (contains currentPath '/reports')}}bg-amber-500/15 text-amber-400 border-l-4 border-amber-500 font-semibold{{else}}text-slate-300 hover:bg-slate-800 hover:text-white{{/if}}">
      <svg class="w-5 h-5 mr-3 flex-shrink-0 {{#if (contains currentPath '/reports')}}text-amber-400{{else}}text-slate-400{{/if}}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
      </svg>
      <span>4. Reports</span>
    </a>

    <!-- 5. Notifications -->
    <a href="/notifications" class="flex items-center justify-between px-3 py-2.5 rounded-md font-medium transition {{#if (contains currentPath '/notifications')}}bg-amber-500/15 text-amber-400 border-l-4 border-amber-500 font-semibold{{else}}text-slate-300 hover:bg-slate-800 hover:text-white{{/if}}">
      <div class="flex items-center">
        <svg class="w-5 h-5 mr-3 flex-shrink-0 {{#if (contains currentPath '/notifications')}}text-amber-400{{else}}text-slate-400{{/if}}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
        </svg>
        <span>5. Notifications</span>
      </div>
      {{#if (gt unreadNotificationCount 0)}}
      <span class="px-2 py-0.5 text-xs font-bold rounded-full bg-rose-600 text-white">
        {{ unreadNotificationCount }}
      </span>
      {{/if}}
    </a>

    <!-- 6. Audit Logs -->
    <a href="/audit-logs" class="flex items-center px-3 py-2.5 rounded-md font-medium transition {{#if (contains currentPath '/audit-logs')}}bg-amber-500/15 text-amber-400 border-l-4 border-amber-500 font-semibold{{else}}text-slate-300 hover:bg-slate-800 hover:text-white{{/if}}">
      <svg class="w-5 h-5 mr-3 flex-shrink-0 {{#if (contains currentPath '/audit-logs')}}text-amber-400{{else}}text-slate-400{{/if}}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
      </svg>
      <span>6. Audit Logs</span>
    </a>

    <!-- 7. Database Backup -->
    <a href="/backups" class="flex items-center px-3 py-2.5 rounded-md font-medium transition {{#if (contains currentPath '/backups')}}bg-amber-500/15 text-amber-400 border-l-4 border-amber-500 font-semibold{{else}}text-slate-300 hover:bg-slate-800 hover:text-white{{/if}}">
      <svg class="w-5 h-5 mr-3 flex-shrink-0 {{#if (contains currentPath '/backups')}}text-amber-400{{else}}text-slate-400{{/if}}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path>
      </svg>
      <span>7. Database Backup</span>
    </a>

    <!-- 8. System Settings -->
    <a href="/settings" class="flex items-center px-3 py-2.5 rounded-md font-medium transition {{#if (contains currentPath '/settings')}}bg-amber-500/15 text-amber-400 border-l-4 border-amber-500 font-semibold{{else}}text-slate-300 hover:bg-slate-800 hover:text-white{{/if}}">
      <svg class="w-5 h-5 mr-3 flex-shrink-0 {{#if (contains currentPath '/settings')}}text-amber-400{{else}}text-slate-400{{/if}}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
      </svg>
      <span>8. System Settings</span>
    </a>

    <!-- 9. My Profile -->
    <a href="/profile" class="flex items-center px-3 py-2.5 rounded-md font-medium transition {{#if (eq currentPath '/profile')}}bg-amber-500/15 text-amber-400 border-l-4 border-amber-500 font-semibold{{else}}text-slate-300 hover:bg-slate-800 hover:text-white{{/if}}">
      <svg class="w-5 h-5 mr-3 flex-shrink-0 {{#if (eq currentPath '/profile')}}text-amber-400{{else}}text-slate-400{{/if}}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
      </svg>
      <span>9. My Profile</span>
    </a>

    <!-- 10. Logout -->
    <a href="/logout" class="flex items-center px-3 py-2.5 rounded-md font-medium text-rose-400 hover:bg-rose-950/40 hover:text-rose-300 transition">
      <svg class="w-5 h-5 mr-3 flex-shrink-0 text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
      </svg>
      <span>10. Logout</span>
    </a>
  </nav>

  <!-- Bottom Admin System Telemetry -->
  <div class="p-3 border-t border-slate-800 bg-slate-950/80">
    <div class="flex items-center justify-between text-[11px] text-slate-400">
      <span class="flex items-center">
        <span class="w-2 h-2 rounded-full bg-emerald-500 mr-1.5 animate-pulse"></span>
        Encrypted Session
      </span>
      <span class="text-slate-500">v1.0 &bull; XianFire</span>
    </div>
  </div>
</aside>

