{{> head}}
<body class="bg-slate-100 font-sans text-slate-800 flex h-screen overflow-hidden">
  {{> sidebar}}

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    {{> navbar}}

    <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-slate-50 space-y-6">
      {{> toast}}

      <div class="flex items-center justify-between pb-2 border-b border-slate-200">
        <div>
          <div class="flex items-center space-x-2 text-xs text-slate-500 mb-1">
            <a href="/personnel" class="hover:text-blue-600">Personnel Management</a>
            <span>&rsaquo;</span>
            <span class="text-slate-800 font-semibold">Edit Account</span>
          </div>
          <h2 class="text-2xl font-black text-slate-900 tracking-tight">Edit Personnel Information</h2>
          <p class="text-xs text-slate-500">Update officer record: <span class="font-bold text-slate-800">{{ personnel.rank }} {{ personnel.first_name }} {{ personnel.last_name }}</span> ({{ personnel.badge_number }})</p>
        </div>
        <a href="/personnel/{{ personnel.id }}" class="px-3.5 py-1.5 bg-white border border-slate-300 text-slate-700 text-xs font-semibold rounded-lg hover:bg-slate-50">&larr; Back to Profile</a>
      </div>

      <div class="jms-card p-6 max-w-4xl">
        <form method="POST" action="/personnel/{{ personnel.id }}/edit" class="space-y-6">
          <div class="bg-slate-50 p-4 rounded-lg border border-slate-200 mb-4 flex items-center justify-between">
            <div>
              <span class="text-xs font-bold text-slate-500 uppercase tracking-wider block">Assigned Badge Number</span>
              <span class="text-base font-black font-mono text-slate-900">{{ personnel.badge_number }}</span>
            </div>
            <div>
              <span class="text-xs font-bold text-slate-500 uppercase tracking-wider block">Official Email</span>
              <span class="text-sm font-semibold text-slate-700">{{ personnel.email }}</span>
            </div>
            <div>
              <span class="text-xs font-bold text-slate-500 uppercase tracking-wider block">Current Status</span>
              <select name="status" class="mt-1 text-xs font-bold px-2 py-1 border border-slate-300 rounded bg-white">
                <option value="active" {{#if (eq personnel.status 'active')}}selected{{/if}}>Active</option>
                <option value="inactive" {{#if (eq personnel.status 'inactive')}}selected{{/if}}>Inactive</option>
                <option value="locked" {{#if (eq personnel.status 'locked')}}selected{{/if}}>Locked</option>
              </select>
            </div>
          </div>

          <!-- Category & Rank -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Personnel Category <span class="text-rose-600">*</span></label>
              <select name="category" required class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white">
                {{#each categories}}
                <option value="{{ this }}" {{#if (eq ../personnel.category this)}}selected{{/if}}>{{ this }}</option>
                {{/each}}
              </select>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Rank / Designation <span class="text-rose-600">*</span></label>
              <input type="text" name="rank" value="{{ personnel.rank }}" required class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
            </div>
          </div>

          <!-- Names -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">First Name <span class="text-rose-600">*</span></label>
              <input type="text" name="first_name" value="{{ personnel.first_name }}" required class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Middle Name</label>
              <input type="text" name="middle_name" value="{{ personnel.middle_name }}" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Last Name <span class="text-rose-600">*</span></label>
              <input type="text" name="last_name" value="{{ personnel.last_name }}" required class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
            </div>
          </div>

          <!-- Contact & Dates -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Phone Number</label>
              <input type="text" name="phone" value="{{ personnel.phone }}" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Birthdate</label>
              <input type="date" name="date_of_birth" value="{{ personnel.date_of_birth }}" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Date Hired / Appointed</label>
              <input type="date" name="date_hired" value="{{ personnel.date_hired }}" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
            </div>
          </div>

          <!-- Addresses -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Emergency Contact Information</label>
              <input type="text" name="emergency_contact" value="{{ personnel.emergency_contact }}" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Residential Address</label>
              <input type="text" name="address" value="{{ personnel.address }}" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Administrative Notes</label>
            <textarea name="notes" rows="2" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white">{{ personnel.notes }}</textarea>
          </div>

          <div class="flex items-center justify-end space-x-3 pt-4 border-t border-slate-200">
            <a href="/personnel/{{ personnel.id }}" class="px-4 py-2 border border-slate-300 text-slate-700 text-xs font-semibold rounded-lg hover:bg-slate-50">Cancel</a>
            <button type="submit" class="px-5 py-2 bg-slate-900 hover:bg-slate-800 text-amber-400 text-xs font-bold rounded-lg shadow transition">
              Save Changes
            </button>
          </div>
        </form>
      </div>
    </main>

    {{> footer}}
  </div>
</body>
</html>

