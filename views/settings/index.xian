{{> head}}
<body class="bg-slate-100 font-sans text-slate-800 flex h-screen overflow-hidden">
  {{> sidebar}}

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    {{> navbar}}

    <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-slate-50 space-y-6">
      {{> toast}}

      <div class="flex items-center justify-between pb-2 border-b border-slate-200">
        <div>
          <h2 class="text-2xl font-black text-slate-900 tracking-tight">System & Facility Settings</h2>
          <p class="text-xs text-slate-500 font-medium mt-0.5">Configure facility metadata, security policies, session timeouts, and disaster recovery rules</p>
        </div>
      </div>

      <form method="POST" action="/settings" class="space-y-6 max-w-5xl">
        <!-- 1. Correctional Facility Profile -->
        <div class="jms-card p-6">
          <div class="flex items-center space-x-2 pb-3 mb-4 border-b border-slate-200">
            <div class="p-1.5 bg-slate-900 text-amber-400 rounded">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Jail Facility Information</h3>
              <p class="text-xs text-slate-500">Official government correctional institution details</p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            <div class="sm:col-span-2">
              <label class="block text-xs font-bold text-slate-700 mb-1">Facility Name <span class="text-rose-600">*</span></label>
              <input type="text" name="facility_name" value="{{ facilitySettings.facility_name }}" required class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Facility Code <span class="text-rose-600">*</span></label>
              <input type="text" name="facility_code" value="{{ facilitySettings.facility_code }}" required class="w-full px-3 py-2 text-sm font-mono border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
            </div>

            <div class="sm:col-span-3">
              <label class="block text-xs font-bold text-slate-700 mb-1">Facility Physical Address</label>
              <input type="text" name="facility_address" value="{{ facilitySettings.facility_address }}" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Official Telephone</label>
              <input type="text" name="contact_number" value="{{ facilitySettings.contact_number }}" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Emergency 24/7 Security Hotline</label>
              <input type="text" name="emergency_hotline" value="{{ facilitySettings.emergency_hotline }}" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Official Institutional Email</label>
              <input type="email" name="official_email" value="{{ facilitySettings.official_email }}" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
            </div>

            <div class="sm:col-span-3">
              <label class="block text-xs font-bold text-slate-700 mb-1">Jail Warden In Charge</label>
              <input type="text" name="warden_in_charge" value="{{ facilitySettings.warden_in_charge }}" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
            </div>
          </div>
        </div>

        <!-- 2. System Branding & Time -->
        <div class="jms-card p-6">
          <div class="flex items-center space-x-2 pb-3 mb-4 border-b border-slate-200">
            <div class="p-1.5 bg-slate-900 text-amber-400 rounded">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">System Name, Motto & Timezone</h3>
              <p class="text-xs text-slate-500">Global application localization and branding attributes</p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="sm:col-span-2">
              <label class="block text-xs font-bold text-slate-700 mb-1">System Display Name</label>
              <input type="text" name="system_name" value="{{ facilitySettings.system_name }}" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
            </div>

            <div class="sm:col-span-2">
              <label class="block text-xs font-bold text-slate-700 mb-1">Official Portal Motto</label>
              <input type="text" name="system_motto" value="{{ facilitySettings.system_motto }}" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Standard System Timezone</label>
              <input type="text" name="timezone" value="{{ facilitySettings.timezone }}" class="w-full px-3 py-2 text-sm font-mono border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Standard Date Format</label>
              <select name="date_format" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white">
                <option value="YYYY-MM-DD" {{#if (eq facilitySettings.date_format 'YYYY-MM-DD')}}selected{{/if}}>YYYY-MM-DD (ISO)</option>
                <option value="MM/DD/YYYY" {{#if (eq facilitySettings.date_format 'MM/DD/YYYY')}}selected{{/if}}>MM/DD/YYYY</option>
                <option value="DD/MM/YYYY" {{#if (eq facilitySettings.date_format 'DD/MM/YYYY')}}selected{{/if}}>DD/MM/YYYY</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Backup Reminder Interval</label>
              <div class="flex items-center space-x-2">
                <input type="number" name="backup_reminder_days" value="{{ facilitySettings.backup_reminder_days }}" min="1" max="30" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
                <span class="text-xs text-slate-500 font-medium">Days</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 3. Security Policy & Session Management -->
        <div class="jms-card p-6">
          <div class="flex items-center space-x-2 pb-3 mb-4 border-b border-slate-200">
            <div class="p-1.5 bg-slate-900 text-amber-400 rounded">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Security Policies & Session Timeout</h3>
              <p class="text-xs text-slate-500">Government security controls and automatic account lockout rules</p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Session Inactivity Timeout</label>
              <div class="flex items-center space-x-2">
                <input type="number" name="session_timeout_minutes" value="{{ facilitySettings.session_timeout_minutes }}" min="5" max="240" required class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
                <span class="text-xs text-slate-500 font-medium">Minutes</span>
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Max Failed Login Attempts</label>
              <div class="flex items-center space-x-2">
                <input type="number" name="max_login_attempts" value="{{ facilitySettings.max_login_attempts }}" min="3" max="10" required class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
                <span class="text-xs text-slate-500 font-medium">Attempts</span>
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Account Lockout Duration</label>
              <div class="flex items-center space-x-2">
                <input type="number" name="lockout_duration_minutes" value="{{ facilitySettings.lockout_duration_minutes }}" min="5" max="1440" required class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
                <span class="text-xs text-slate-500 font-medium">Minutes</span>
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Minimum Password Length</label>
              <div class="flex items-center space-x-2">
                <input type="number" name="min_password_length" value="{{ facilitySettings.min_password_length }}" min="8" max="32" required class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
                <span class="text-xs text-slate-500 font-medium">Chars</span>
              </div>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-end space-x-3 pt-2">
          <button type="submit" class="px-6 py-2.5 bg-slate-900 hover:bg-slate-800 text-amber-400 font-bold text-xs rounded-lg shadow-md transition flex items-center space-x-2 border border-slate-700">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <span>Save All System Configurations</span>
          </button>
        </div>
      </form>
    </main>

    {{> footer}}
  </div>
</body>
</html>
