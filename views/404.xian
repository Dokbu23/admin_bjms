{{> head}}
<body class="bg-slate-900 min-h-screen flex items-center justify-center p-4">
  <div class="max-w-md w-full text-center">
    <div class="inline-flex w-16 h-16 rounded-xl bg-slate-800 text-amber-400 items-center justify-center border-2 border-amber-500 mb-4 shadow-xl">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
    </div>
    <h1 class="text-4xl font-black text-white tracking-wider">404</h1>
    <h2 class="text-lg font-bold text-amber-400 mt-1 uppercase tracking-wide">Resource Not Found</h2>
    <p class="text-xs text-slate-400 mt-2 mb-6">
      The requested administrative path or record does not exist on this secure server.
    </p>
    <a href="/dashboard" class="inline-flex items-center space-x-2 px-5 py-2.5 bg-slate-800 hover:bg-slate-700 text-white text-xs font-bold rounded-lg border border-slate-700 shadow">
      <span>&larr; Return to Dashboard</span>
    </a>
  </div>
</body>
</html>

