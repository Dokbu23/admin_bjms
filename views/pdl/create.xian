{{> head}}
<body class="bg-slate-100 font-sans text-slate-800 flex h-screen overflow-hidden">
  {{> sidebar}}

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    {{> navbar}}

    <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-slate-50 space-y-6">
      {{> toast}}

      <div class="flex items-center justify-between pb-2 border-b border-slate-200">
        <div>
          <div class="flex items-center space-x-2 text-xs text-slate-500 mb-1">
            <a href="/pdl" class="hover:text-blue-600">PDL Records</a>
            <span>&rsaquo;</span>
            <span class="text-slate-800 font-semibold">New Registration</span>
          </div>
          <h2 class="text-2xl font-black text-slate-900 tracking-tight">Register New PDL Intake</h2>
          <p class="text-xs text-slate-500">Record comprehensive intake identity, charges, court orders, and custodial assignments</p>
        </div>
        <a href="/pdl" class="px-3.5 py-1.5 bg-white border border-slate-300 text-slate-700 text-xs font-semibold rounded-lg hover:bg-slate-50">&larr; Back to Roster</a>
      </div>

      <div class="jms-card p-6 max-w-5xl">
        <form method="POST" action="/pdl" class="space-y-6">
          <!-- 1. Identification & Official PDL Number -->
          <div class="bg-slate-50 p-4 rounded-lg border border-slate-200">
            <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-3">Custodial Identification</h3>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Official PDL ID Number <span class="text-rose-600">*</span></label>
                <input 
                  type="text" 
                  name="pdl_number" 
                  value="{{ suggestedPdlNumber }}" 
                  required 
                  class="w-full px-3 py-2 text-sm font-mono font-bold text-slate-900 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white"
                />
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Admission Date <span class="text-rose-600">*</span></label>
                <input 
                  type="date" 
                  name="admission_date" 
                  required 
                  class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white"
                />
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Initial Detention Status <span class="text-rose-600">*</span></label>
                <select name="detention_status" required class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white">
                  {{#each statuses}}
                  <option value="{{ this }}">{{ this }}</option>
                  {{/each}}
                </select>
              </div>
            </div>
          </div>

          <!-- 2. Personal Information -->
          <div>
            <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-3 pb-1 border-b border-slate-200">Personal Demographics</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">First Name <span class="text-rose-600">*</span></label>
                <input type="text" name="first_name" required class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Middle Name</label>
                <input type="text" name="middle_name" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Last Name <span class="text-rose-600">*</span></label>
                <input type="text" name="last_name" required class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Alias / Street Name</label>
                <input type="text" name="alias" placeholder="e.g. Alyas Monching" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Date of Birth</label>
                <input type="date" name="date_of_birth" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Gender</label>
                <select name="gender" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white">
                  <option value="Male">Male</option>
                  <option value="Female">Female</option>
                  <option value="Other">Other</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Civil Status</label>
                <select name="civil_status" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white">
                  <option value="Single">Single</option>
                  <option value="Married">Married</option>
                  <option value="Widowed">Widowed</option>
                  <option value="Separated">Separated</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Nationality</label>
                <input type="text" name="nationality" value="Filipino" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
              </div>
            </div>
          </div>

          <!-- 3. Legal & Custodial Placement -->
          <div>
            <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-3 pb-1 border-b border-slate-200">Legal Case & Custodial Placement</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Criminal Case Number <span class="text-rose-600">*</span></label>
                <input type="text" name="case_number" placeholder="e.g. CR-2026-1044" required class="w-full px-3 py-2 text-sm font-mono border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Court Branch</label>
                <input type="text" name="court_branch" placeholder="e.g. RTC Branch 104, Quezon City" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Risk Classification <span class="text-rose-600">*</span></label>
                <select name="risk_level" required class="w-full px-3 py-2 text-sm font-semibold border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white">
                  {{#each riskLevels}}
                  <option value="{{ this }}">{{ this }} Risk</option>
                  {{/each}}
                </select>
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Assigned Cell / Block <span class="text-rose-600">*</span></label>
                <input type="text" name="cell_block" placeholder="e.g. Block A - Cell 04" required class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
              </div>

              <div class="sm:col-span-4">
                <label class="block text-xs font-bold text-slate-700 mb-1">Criminal Offense / Charge Specification <span class="text-rose-600">*</span></label>
                <input type="text" name="offense_charge" placeholder="e.g. Violation of RA 9165 Sec. 5, Qualified Theft, Robbery with Intimidation..." required class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
              </div>
            </div>
          </div>

          <!-- 4. Contacts & Health -->
          <div>
            <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-3 pb-1 border-b border-slate-200">Address, Emergency & Health Info</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Permanent Residential Address</label>
                <input type="text" name="address" placeholder="Barangay, City/Municipality" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Emergency Contact Name & Kinship</label>
                <input type="text" name="emergency_contact_name" placeholder="e.g. Maria Santos (Spouse)" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Emergency Contact Phone Number</label>
                <input type="text" name="emergency_contact_phone" placeholder="+63 900 000 0000" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white" />
              </div>

              <div class="sm:col-span-3">
                <label class="block text-xs font-bold text-slate-700 mb-1">Medical Conditions / Allergies / Maintenance Medications</label>
                <textarea name="medical_conditions" rows="2" placeholder="e.g. Hypertension under BP medication, Asthma, diabetic..." class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white"></textarea>
              </div>

              <div class="sm:col-span-3">
                <label class="block text-xs font-bold text-slate-700 mb-1">Administrative Remarks & Commitment Notes</label>
                <textarea name="remarks" rows="2" placeholder="e.g. Commitment order signed by presiding judge, special security precautions..." class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white"></textarea>
              </div>
            </div>
          </div>

          <div class="flex items-center justify-end space-x-3 pt-4 border-t border-slate-200">
            <a href="/pdl" class="px-4 py-2 border border-slate-300 text-slate-700 text-xs font-semibold rounded-lg hover:bg-slate-50">Cancel</a>
            <button type="submit" class="px-5 py-2 bg-slate-900 hover:bg-slate-800 text-amber-400 text-xs font-bold rounded-lg shadow transition">
              Complete PDL Intake Registration
            </button>
          </div>
        </form>
      </div>
    </main>

    {{> footer}}
  </div>
</body>
</html>

