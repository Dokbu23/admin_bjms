<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} - Government Jail Management System</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @media print {
      .no-print { display: none !important; }
      body { background-color: #ffffff !important; }
      @page { margin: 1cm; size: landscape; }
    }
    table { border-collapse: collapse; width: 100%; }
    th, td { border: 1px solid #cbd5e1; padding: 6px 10px; font-size: 11px; }
    th { background-color: #f1f5f9; text-align: left; font-weight: bold; }
  </style>
</head>
<body class="bg-white p-6 text-slate-900 font-sans">
  <!-- Print Controls Toolbar -->
  <div class="no-print mb-6 p-4 bg-slate-100 rounded-lg border border-slate-300 flex items-center justify-between">
    <div class="text-xs text-slate-700">
      <strong>Official Print Document Ready:</strong> Click Print or save as PDF.
    </div>
    <div class="flex items-center space-x-3">
      <button onclick="window.print()" class="px-4 py-2 bg-slate-900 text-amber-400 font-bold text-xs rounded shadow hover:bg-slate-800">
        Print / Save to PDF
      </button>
      <button onclick="window.close()" class="px-3 py-2 bg-slate-200 text-slate-700 font-semibold text-xs rounded hover:bg-slate-300">
        Close Window
      </button>
    </div>
  </div>

  <!-- Government Agency Letterhead -->
  <div class="text-center pb-4 mb-6 border-b-2 border-slate-900">
    <p class="text-[11px] font-serif uppercase tracking-widest text-slate-700">Republic of the Philippines</p>
    <p class="text-xs font-serif font-bold uppercase tracking-wider text-slate-900">Department of the Interior and Local Government</p>
    <p class="text-sm font-serif font-extrabold uppercase tracking-wide text-slate-900">Bureau of Jail Management and Penology</p>
    <p class="text-xs font-semibold text-slate-700 uppercase mt-0.5">{{ facilityName }}</p>
    <h1 class="text-base font-black uppercase tracking-wider mt-4 text-slate-950">{{ reportTitle }}</h1>
    <p class="text-[11px] text-slate-500 font-mono mt-1">Official Document Telemetry &bull; Generated: {{ generatedDate }} &bull; Admin: {{ generatedBy }}</p>
  </div>

  <!-- Data Table -->
  <div class="overflow-x-auto mb-8">
    <table>
      <thead>
        <tr>
          {{#each headers}}
          <th>{{ this }}</th>
          {{/each}}
        </tr>
      </thead>
      <tbody>
        {{#each rows}}
        <tr>
          {{#each this}}
          <td>{{ this }}</td>
          {{/each}}
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  <!-- Government Sign-off Authentication Block -->
  <div class="grid grid-cols-2 gap-12 pt-8 text-xs text-slate-800 break-inside-avoid">
    <div>
      <p class="text-slate-500 font-medium">Prepared & Certified Correct by:</p>
      <div class="mt-12 pt-1 border-t border-slate-800 max-w-xs">
        <p class="font-bold text-sm text-slate-900 uppercase">{{ generatedBy }}</p>
        <p class="text-[11px] text-slate-600 font-semibold">System Administrator &bull; IT & Records Section</p>
      </div>
    </div>

    <div class="text-right flex flex-col items-end">
      <p class="text-slate-500 font-medium">Approved & Noted by:</p>
      <div class="mt-12 pt-1 border-t border-slate-800 w-full max-w-xs text-left">
        <p class="font-bold text-sm text-slate-900 uppercase">J/SSUPT Leonardo S. Mendoza, DSC</p>
        <p class="text-[11px] text-slate-600 font-semibold">Jail Senior Superintendent &bull; Jail Warden</p>
      </div>
    </div>
  </div>
</body>
</html>

