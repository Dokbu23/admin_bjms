{{> head}}
<body class="bg-slate-100 font-sans text-slate-800 flex h-screen overflow-hidden">
  {{> sidebar}}

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    {{> navbar}}

    <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-slate-50 space-y-6">
      {{> toast}}

      <!-- Page Header with Export Buttons -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-2 border-b border-slate-200 gap-4">
        <div>
          <div class="flex items-center space-x-2 text-xs text-slate-500 mb-1">
            <a href="/reports" class="hover:text-blue-600">Reports Center</a>
            <span>&rsaquo;</span>
            <span class="text-slate-800 font-semibold uppercase">{{ reportType }}</span>
          </div>
          <h2 class="text-2xl font-black text-slate-900 tracking-tight">{{ reportTitle }}</h2>
          <p class="text-xs text-slate-500 font-medium">{{ facilityName }} &bull; Generated Live from MySQL Database</p>
        </div>

        <!-- Export Buttons Group -->
        <div class="flex flex-wrap items-center gap-2">
          <a href="/reports/{{ reportType }}?format=pdf&start_date={{ start_date }}&end_date={{ end_date }}&search={{ search }}" target="_blank" class="px-3 py-1.5 bg-rose-700 hover:bg-rose-800 text-white text-xs font-bold rounded-lg shadow-sm transition inline-flex items-center space-x-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
            <span>Print / PDF</span>
          </a>
          <a href="/reports/{{ reportType }}?format=excel&start_date={{ start_date }}&end_date={{ end_date }}&search={{ search }}" class="px-3 py-1.5 bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-bold rounded-lg shadow-sm transition inline-flex items-center space-x-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            <span>Export Excel</span>
          </a>
          <a href="/reports/{{ reportType }}?format=csv&start_date={{ start_date }}&end_date={{ end_date }}&search={{ search }}" class="px-3 py-1.5 bg-blue-700 hover:bg-blue-800 text-white text-xs font-bold rounded-lg shadow-sm transition inline-flex items-center space-x-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
            <span>Export CSV</span>
          </a>
        </div>
      </div>

      <!-- Date Filters & Search -->
      <div class="jms-card p-4">
        <form method="GET" action="/reports/{{ reportType }}" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          <div>
            <label class="block text-[11px] font-bold text-slate-600 mb-1">Date From</label>
            <input type="date" name="start_date" value="{{ start_date }}" class="w-full px-3 py-1.5 text-xs border border-slate-300 rounded-lg bg-slate-50" />
          </div>

          <div>
            <label class="block text-[11px] font-bold text-slate-600 mb-1">Date To</label>
            <input type="date" name="end_date" value="{{ end_date }}" class="w-full px-3 py-1.5 text-xs border border-slate-300 rounded-lg bg-slate-50" />
          </div>

          <div>
            <label class="block text-[11px] font-bold text-slate-600 mb-1">Search Keywords</label>
            <input type="text" name="search" value="{{ search }}" placeholder="Filter records..." class="w-full px-3 py-1.5 text-xs border border-slate-300 rounded-lg bg-slate-50" />
          </div>

          <div class="flex items-end space-x-2">
            <button type="submit" class="flex-1 py-1.5 px-3 bg-slate-900 text-amber-400 text-xs font-bold rounded-lg hover:bg-slate-800 transition">
              Apply Filters
            </button>
            <a href="/reports/{{ reportType }}" class="py-1.5 px-3 bg-slate-200 text-slate-700 text-xs font-semibold rounded-lg hover:bg-slate-300 transition">
              Reset
            </a>
          </div>
        </form>
      </div>

      <!-- Report Preview Data Table -->
      <div class="jms-card overflow-hidden">
        <div class="px-5 py-3 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
          <span class="text-xs font-bold text-slate-700 uppercase tracking-wider">
            Report Data Preview ({{ rows.length }} Results Found)
          </span>
          <span class="text-xs text-slate-400 font-mono">Generated: {{formatDate ''}}</span>
        </div>

        <div class="overflow-x-auto">
          <table class="jms-table">
            <thead>
              <tr>
                {{#each headers}}
                <th>{{ this }}</th>
                {{/each}}
              </tr>
            </thead>
            <tbody>
              {{#each rows}}
              <tr>
                {{#each this}}
                <td class="text-xs">{{ this }}</td>
                {{/each}}
              </tr>
              {{else}}
              <tr>
                <td colspan="{{ headers.length }}" class="text-center py-10 text-slate-500">
                  <p class="text-sm font-semibold">No records found for the selected filter parameters.</p>
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    </main>

    {{> footer}}
  </div>
</body>
</html>

