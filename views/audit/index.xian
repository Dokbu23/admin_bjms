{{> head}}
<body class="bg-slate-100 font-sans text-slate-800 flex h-screen overflow-hidden">
  {{> sidebar}}

  <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    {{> navbar}}

    <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 bg-slate-50 space-y-6">
      {{> toast}}

      <!-- Page Header -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-2 border-b border-slate-200 gap-4">
        <div>
          <h2 class="text-2xl font-black text-slate-900 tracking-tight">Audit Logs & Forensic Trail</h2>
          <p class="text-xs text-slate-500 font-medium mt-0.5">Immutable, read-only system telemetry capturing logins, record mutations, and administrative activities</p>
        </div>

        <!-- Export Dropdown -->
        <div class="relative inline-block text-left" id="export-audit-dropdown">
          <button onclick="document.getElementById('audit-export-menu').classList.toggle('hidden')" class="px-3.5 py-2 bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 text-xs font-bold rounded-lg shadow-sm transition inline-flex items-center space-x-1.5">
            <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            <span>Export Audit Trail</span>
            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          <div id="audit-export-menu" class="hidden absolute right-0 mt-2 w-48 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 z-20 py-1">
            <a href="/audit-logs/export/pdf" target="_blank" class="block px-4 py-2 text-xs text-slate-700 hover:bg-slate-100 flex items-center space-x-2">
              <svg class="w-4 h-4 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
              <span>Export as PDF / Print</span>
            </a>
            <a href="/audit-logs/export/excel" class="block px-4 py-2 text-xs text-slate-700 hover:bg-slate-100 flex items-center space-x-2">
              <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
              <span>Export as Excel (.xls)</span>
            </a>
            <a href="/audit-logs/export/csv" class="block px-4 py-2 text-xs text-slate-700 hover:bg-slate-100 flex items-center space-x-2">
              <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
              <span>Export as CSV</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Filters & Multi-Search -->
      <div class="jms-card p-4">
        <form method="GET" action="/audit-logs" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
          <!-- Search -->
          <div class="relative lg:col-span-1">
            <input 
              type="text" 
              name="search" 
              value="{{ search }}" 
              placeholder="Search description, IP..." 
              class="w-full px-3 py-1.5 text-xs border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-slate-50"
            />
          </div>

          <!-- Action Filter -->
          <div>
            <select name="action" onchange="this.form.submit()" class="w-full px-3 py-1.5 text-xs border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-slate-50 text-slate-700">
              <option value="">All Activity Actions</option>
              {{#each distinctActions}}
              <option value="{{ this }}" {{#if (eq ../selectedAction this)}}selected{{/if}}>{{ this }}</option>
              {{/each}}
            </select>
          </div>

          <!-- User Filter -->
          <div>
            <select name="user" onchange="this.form.submit()" class="w-full px-3 py-1.5 text-xs border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-slate-50 text-slate-700">
              <option value="">All Actors / Users</option>
              {{#each distinctUsers}}
              <option value="{{ this.user_email }}" {{#if (eq ../selectedUser this.user_email)}}selected{{/if}}>{{ this.user_name }}</option>
              {{/each}}
            </select>
          </div>

          <!-- Date Range: Start -->
          <div>
            <input 
              type="date" 
              name="start_date" 
              value="{{ startDate }}" 
              class="w-full px-3 py-1.5 text-xs border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-slate-50 text-slate-700"
              title="Start Date"
            />
          </div>

          <!-- Date Range: End & Submit -->
          <div class="flex items-center space-x-1.5">
            <input 
              type="date" 
              name="end_date" 
              value="{{ endDate }}" 
              class="flex-1 px-3 py-1.5 text-xs border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500 bg-slate-50 text-slate-700"
              title="End Date"
            />
            <button type="submit" class="py-1.5 px-3 bg-slate-900 text-amber-400 text-xs font-bold rounded-lg hover:bg-slate-800 transition">
              Filter
            </button>
            <a href="/audit-logs" class="py-1.5 px-2 bg-slate-200 text-slate-700 text-xs font-semibold rounded-lg hover:bg-slate-300 transition" title="Clear Filters">
              Reset
            </a>
          </div>
        </form>
      </div>

      <!-- Audit Logs Data Table -->
      <div class="jms-card overflow-hidden">
        <div class="px-5 py-3 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
          <span class="text-xs font-bold text-slate-700 uppercase tracking-wider">
            Audit Activity Trail ({{ totalCount }} Events Recorded)
          </span>
          <span class="text-xs text-slate-500 font-medium">Page {{ currentPage }} of {{ totalPages }}</span>
        </div>

        <div class="overflow-x-auto">
          <table class="jms-table">
            <thead>
              <tr>
                <th>Timestamp</th>
                <th>User Account</th>
                <th>Activity Action</th>
                <th>Description</th>
                <th>Target Entity</th>
                <th>IP Address</th>
                <th>Client Agent</th>
              </tr>
            </thead>
            <tbody>
              {{#each logs}}
              <tr>
                <td class="font-mono text-xs text-slate-600 whitespace-nowrap">
                  {{formatDateTime this.createdAt}}
                </td>
                <td class="whitespace-nowrap">
                  <div class="font-bold text-xs text-slate-900">{{ this.user_name }}</div>
                  <div class="text-[11px] text-slate-500">{{ this.user_email }}</div>
                </td>
                <td class="whitespace-nowrap">
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-slate-900 text-amber-400">
                    {{ this.action }}
                  </span>
                </td>
                <td class="text-xs text-slate-800 max-w-md">
                  <div class="font-medium leading-relaxed">{{ this.description }}</div>
                  {{#if this.old_values}}
                  <details class="mt-1">
                    <summary class="text-[10px] text-blue-600 cursor-pointer hover:underline font-mono">View State Diffs</summary>
                    <div class="p-2 bg-slate-100 rounded text-[10px] font-mono text-slate-700 mt-1 max-w-xs overflow-x-auto border border-slate-200">
                      <div><strong class="text-rose-700">OLD:</strong> {{ this.old_values }}</div>
                      <div><strong class="text-emerald-700">NEW:</strong> {{ this.new_values }}</div>
                    </div>
                  </details>
                  {{/if}}
                </td>
                <td class="text-xs text-slate-600 font-mono whitespace-nowrap">
                  {{#if this.affected_table}}
                    {{ this.affected_table }} #{{ this.affected_id }}
                  {{else}}
                    <span class="text-slate-400 italic">System</span>
                  {{/if}}
                </td>
                <td class="font-mono text-xs text-slate-600 whitespace-nowrap">
                  {{ this.ip_address }}
                </td>
                <td class="text-[11px] text-slate-400 max-w-[150px] truncate" title="{{ this.user_agent }}">
                  {{ this.user_agent }}
                </td>
              </tr>
              {{else}}
              <tr>
                <td colspan="7" class="text-center py-10 text-slate-500">
                  <p class="text-sm font-semibold">No audit logs matching query criteria.</p>
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        {{#if (gt totalPages 1)}}
        <div class="px-5 py-3 border-t border-slate-200 bg-slate-50 flex items-center justify-between">
          <div class="text-xs text-slate-500">
            Showing page {{ currentPage }} of {{ totalPages }}
          </div>
          <div class="flex items-center space-x-1">
            {{#if hasPrev}}
            <a href="/audit-logs?page={{ prevPage }}&search={{ search }}&action={{ selectedAction }}&user={{ selectedUser }}&start_date={{ startDate }}&end_date={{ endDate }}" class="px-3 py-1 bg-white border border-slate-300 rounded text-xs font-semibold text-slate-700 hover:bg-slate-100">Previous</a>
            {{/if}}
            {{#if hasNext}}
            <a href="/audit-logs?page={{ nextPage }}&search={{ search }}&action={{ selectedAction }}&user={{ selectedUser }}&start_date={{ startDate }}&end_date={{ endDate }}" class="px-3 py-1 bg-white border border-slate-300 rounded text-xs font-semibold text-slate-700 hover:bg-slate-100">Next</a>
            {{/if}}
          </div>
        </div>
        {{/if}}
      </div>
    </main>

    {{> footer}}
  </div>

  <script>
    document.addEventListener("click", (e) => {
      const wrapper = document.getElementById("export-audit-dropdown");
      const menu = document.getElementById("audit-export-menu");
      if (wrapper && menu && !wrapper.contains(e.target)) {
        menu.classList.add("hidden");
      }
    });
  </script>
</body>
</html>

